Flag treatments that drop under minimum dose range:
```{r}
levels<-plot |> 
  distinct(project_id, collected_datetime, Value,.keep_all=T) |> 
  filter(!is.na(Value)) |> 
  group_by(project_id) |> 
  mutate(average_level=mean(Value)) |> 
  mutate(below_range=ifelse(Value<5,1,0)) |> 
  mutate(range_average=mean(below_range))

levels |> 
  filter(range_average>0.5) |> 
  count(project_id) #n=7/188 were under range more often than above minimum

levels |> 
  filter(average_level<5) |> 
  count(project_id)
```

Identify patients who had a transplant rejection:
```{r}
plot<-diagnoses |> 
  filter(str_detect(diag_name, "Kidney transplant failure and rejection")) |> 
  select(project_id, diag_name, start_datetime) |> 
  distinct(project_id,.keep_all=T) |> 
  right_join(plot, by= "project_id") |> 
  mutate(rejection=ifelse(!is.na(diag_name.x),1,0)) |> 
  group_by(project_id) |> 
  fill(rejection,.direction="updown") |> 
  ungroup()


plot |> 
  distinct(project_id,.keep_all=T) |> 
  count(rejection) #n=55/133 had a rejection

plot |> 
  distinct(project_id,.keep_all=T) |> 
  count(rejection, below_range)
```


