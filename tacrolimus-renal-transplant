Isolate tacrolimus admins and list chronologically
```{r}
tacrolimus<-medication_admins |> 
  filter(str_detect(drug_name, "TACROLIMUS")) |> 
  filter(!str_detect(drug_name, "OINTMENT"))

cohort_with_meds<-cohort |> merge(tacrolimus, by = "project_id") |>
  mutate(start_datetime.y=as_datetime(start_datetime.y)) |> 
  arrange(project_id,start_datetime.y)
```

Compare transplant time and initiation of treatment
```{r}
cohort_with_meds<-cohort_with_meds |> 
  group_by(project_id) |> 
  mutate(transplant_time=as_datetime(start_datetime.x)) |> 
  mutate(tacrolimus_index_time=min(as_datetime(start_datetime.y))) |>
  ungroup() |>  
  mutate(tacrolimus_admin_time=as_datetime(start_datetime.y)) |> 
  mutate(prn_dose=as.numeric(str_replace(prn_dose," mg",""))) |> 
  rename(prn_dose_mg=prn_dose) |> 
  select(project_id,birth_date,sex_name, transplant_time, procedure_name, tacrolimus_index_time,tacrolimus_admin_time,prn_dose_mg,drug_name,intended_frequency)
```

Calculate time between tacrolimus treatments
```{r}
cohort_with_meds<-cohort_with_meds |> 
  group_by(project_id) |> 
  arrange(project_id, tacrolimus_admin_time) |> 
  distinct(project_id, tacrolimus_admin_time,.keep_all=T) |> 
  mutate(time_between_tx=difftime(tacrolimus_admin_time, lag(tacrolimus_admin_time), units = "mins")) |> 
  ungroup()
```

Link tacrolimus blood measurements
```{r}
labs_clean<-lab_components |> 
  filter(str_detect(TestName, "Tacrolimus Level")) |> 
  filter(Unit=="microg/L") |> 
  arrange(project_id,collected_datetime) |> 
  select(project_id,collected_datetime, TestName, Value, Unit, reference_range) |> 
  mutate(collected_datetime=as_datetime(collected_datetime)) |> 
  group_by(project_id) |> 
  mutate(time_between_readings=difftime(collected_datetime, lag (collected_datetime), units = "mins")) |> 
  mutate(timefromindex=difftime(collected_datetime, min(collected_datetime), units = "hours"))

lab_components |> 
  filter(str_detect(TestName, "Tacrolimus|tacrol")) |> 
  count(TestName)
```

```{r}
plot<-labs_clean |> 
  merge(cohort_with_meds, by = "project_id") |> 
  select(project_id,tacrolimus_admin_time,prn_dose_mg,collected_datetime, Value, reference_range ) |> 
  arrange(project_id, desc(tacrolimus_admin_time),collected_datetime) |> 
  mutate(timediff=difftime(collected_datetime,tacrolimus_admin_time, units = "mins")) |> 
  group_by(project_id, tacrolimus_admin_time) |> 
  filter(timediff>0) |> 
  arrange(project_id, collected_datetime, timediff) |> 
  distinct(project_id, tacrolimus_admin_time,collected_datetime,timediff,.keep_all=T) |> 
  ungroup() |> 
  mutate(time_since_last_dose=as.numeric(difftime(collected_datetime, tacrolimus_admin_time, units = "hours"))) |> 
  mutate(Value=as.numeric(Value)) |> 
  arrange(project_id, collected_datetime, time_since_last_dose) |> 
  distinct(project_id, tacrolimus_admin_time,.keep_all=T) |> 
  mutate(restriction=ifelse(time_since_last_dose>168,1,NA)) |> 
  arrange(project_id, collected_datetime) |> 
  group_by(project_id) |> 
  #fill(restriction,.direction = "updown") |> 
  filter(is.na(restriction)) |> 
  ungroup()

plot |> 
  count(project_id)#n=88
```

