Link SNOMED and dm+d together:
```{r}
snomed_mapping_file |> 
  count(VTM) #n=3103 VTMs

vtm |> 
  count(VTMID)

snomed_dmd<-snomed_mapping_file |>  #n=406,290 lines in snomed
  rename(VTMID=VTM) |> #merge on VTM
left_join(vtm, by="VTMID") #n=3253 lines in the vtm dm+d file

snomed_mapping_file |> 
  filter(`VTM Name`=="Fentanyl")


snomed_dmd |> 
  distinct(VTMID,.keep_all=T) #n=3,103 preserved
```
```{r}
snomed_dmd_bnflink<-snomed_dmd |> 
  rename(BNF_PRESENTATION_CODE=`BNF Code`) |> 
  merge(bnf_codes, by = "BNF_PRESENTATION_CODE") #|> 
  #select(VTMID, `VTM Name`,`BNF Name`, BNF_SECTION, BNF_PARAGRAPH)
```
Save SNOMED/BNF/DMD linked data
```{r}
write_csv(snomed_dmd_bnflink, "snomed_bnf_dmd_link.csv")
```


Normalize join keys to lower case before joining - this may help increase linkage
```{r}
# Case-insensitive join
snomed_dmd_bnflink <- snomed_dmd_bnflink %>%
mutate_all(~ tolower(.))

formulary_list<-formulary_list |> 
mutate_all(~ tolower(.))
```

Relink updated database:
```{r}
bnfsection_update<-read_csv(
"pharmaceutical_class_updated.csv",
  col_names = TRUE,
  col_types = cols(.default = col_character()),
  col_select = NULL)|> 
mutate_all(~ tolower(.)) |> 
  select(1,4)

bnfsection_update2<-read_csv(
"therapeutic_class_updated.csv",
  col_names = TRUE,
  col_types = cols(.default = col_character()),
  col_select = NULL)|> 
mutate_all(~ tolower(.)) |> 
  select(1,4)

formulary_list<-formulary_list |> 
  left_join(bnfsection_update, by="Pharmaceutical class") |> 
  select(`Pharmaceutical class`, `BNF Version`) |> 
  distinct(`Pharmaceutical class`,.keep_all=T) |> 
  right_join(formulary_list, by = "Pharmaceutical class") |> 
  mutate(`Pharmaceutical class`=ifelse(`Pharmaceutical class`!=`BNF Version`&!is.na(`BNF Version`), `BNF Version`, `Pharmaceutical class`)) |> 
  select(-`BNF Version`) 

formulary_list<-formulary_list |> 
  left_join(bnfsection_update2, by="Therapeutic class") |> 
  select(`Therapeutic class`, `BNF_Version`) |> 
  distinct(`Therapeutic class`,.keep_all=T) |> 
  right_join(formulary_list, by = "Therapeutic class") |> 
  mutate(`Therapeutic class`=ifelse(`Therapeutic class`!=`BNF_Version`&!is.na(`BNF_Version`), `BNF_Version`, `Therapeutic class`)) |> 
  select(-`BNF_Version`)# |> 
  #filter(str_detect(`Therapeutic class`, "gastro"))
```
Join GOSH formulary to dm+d/BNF/SNOMED linked data:
```{r}
dataset<-snomed_dmd_bnflink |> 
  mutate(`Drug...2`=`VTM Name`) |> 
  distinct(`VTM Name`, BNF_CHAPTER,BNF_SECTION,BNF_PARAGRAPH,BNF_SUBPARAGRAPH,.keep_all = T) |> 
  select(`VTM Name`,Drug...2,BNF_PRODUCT,BNF_CHAPTER, BNF_SECTION,BNF_PARAGRAPH, BNF_SUBPARAGRAPH) |> 
  arrange(`VTM Name`) |> 
  mutate(`Pharmaceutical class`=`BNF_SECTION`) |> 
  mutate(`Therapeutic class`=`BNF_CHAPTER`) |>   
  right_join(formulary_list, by= c("Drug...2","Pharmaceutical class","Therapeutic class")) |>   #firstly link on drug and pharmaceutical class for drugs where there is more than one indication

  select(`VTM Name`,Drug...1,Drug...2, BNF_PRODUCT, `Pharmaceutical class`, BNF_SECTION, `Therapeutic class`, BNF_CHAPTER,`Therapeutic Subclass`, BNF_SUBPARAGRAPH)

datasetlink1<-dataset|> 
  filter(!is.na(BNF_SECTION)) |> 
  mutate(dataset="one")

datasetlink1 |> 
  filter(!is.na(BNF_SECTION)) #n=608/1181 match exactly on DRUG and BNF_SECTION and BNF_CHAPTER

dataset |> 
  filter(is.na(BNF_SECTION)) 
```

