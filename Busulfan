Merge on everything as it matches:
```{r}
dataset<-closest_level |> 
  merge(closest_antib, by = c("MRN", "AdministrationInstant", "MedicationAdministrationKey","PersonHeight_X","PersonWeight_X","PatientDurableKey","MedFullName","ScheduledAdministrationInstant","Frequency","AdministrationRoute","LastName","FirstName","Mode","Dose","DoseUnit","OrderPriority","Department","AdminBy","IsHospitalAdmission","TherapeuticClass","AdministrationAction")) |> 
  arrange(MRN, CollectedInstant)
```

```{r}
dataset_full<- dataset |> 
 right_join(levels, by= c("MRN", "PatientDurableKey","CollectedInstant" )) 
```

```{r}
dataset_full<-dataset_full |> 
  mutate(CollectedInstant=as_datetime(CollectedInstant)) |> 
  mutate(ScheduledAdministrationInstant=as_datetime(ScheduledAdministrationInstant)) 
```
Plot time series:
```{r}
# Install and load ggpubr if not already installed
# install.packages("ggpubr")
library(dplyr)
library(lubridate)  # For time parsing
library(hms) 
library(ggpubr)
Voriconazole<-dataset_full |> 
  filter(AntiB=="Voriconazole") |> 
  mutate(SeqTimeMins=as.numeric(SeqTimeMins)) |> 
  mutate(Result.y=as.numeric(Result.y)) |> 
  arrange(MRN, CollectedInstant) |> 
  ungroup()

# Scatter plot with date on x-axis
p <- ggscatter(                                                             
  Voriconazole,
  x = "SeqTimeMins",
  y = "Result.y",
  color = "blue",          # point color
  size = 1,                # point size
  add = "reg.line",            # connect points with a line
  add.params = list(color = "black", size = 0.1),
 xlab = "Time from infusion (minutes)",  ylab = "Voriconazole value" 
) +ylim(c(0,10))+ xlim(0,6000)+
  theme_minimal()#+        # clean theme
 
#scale_x_discrete(breaks = c(60,120,180,240,300,360,420,480,540,600)) # format axis

# Print plot
print(p)
```
