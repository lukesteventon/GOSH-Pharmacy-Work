```

Link data:
```{r}
labs<-lab_components |> 
   filter(str_detect(component_name,"Busulfan")) |> 
  mutate(busulfan_admin_time=start_datetime) |> 
  distinct(project_id, busulfan_admin_time, .keep_all=T)

busulfan_cohort<- cohort |> 
  merge(labs, by= "project_id") |> 
  arrange(project_id,busulfan_admin_time) |> 
  distinct(project_id, busulfan_admin_time, collected_datetime,.keep_all=T)


busulfan_cohort |> 
  count(project_id) #n=18 with labs
```

```{r}
height_weight_data<-flowsheet_rows |> 
  filter(str_detect(type, "HEIGHT_centimetres|WEIGHT/SCALE_grams")) |> 
  select(project_id, DisplayName, type, Value,start_datetime) |> 
  mutate(Value=as.numeric(Value)) |> 
  mutate(start_datetime=as.POSIXct(start_datetime))

cohort<-height_weight_data |> 
  group_by(project_id, DisplayName) |> 
  mutate(height=ifelse(DisplayName=="Height", mean(Value),NA)) |> 
  mutate(weight=ifelse(DisplayName=="Weight", mean(Value),NA)) |> 
  group_by(project_id) |> 
  fill(height, .direction="updown") |> 
  fill(weight, .direction="updown") |> 
  ungroup() |> 
  distinct(project_id,.keep_all=T) |> 
  ungroup() |> 
  right_join(busulfan_cohort, by = "project_id") |> 
  distinct(project_id, busulfan_admin_time, collected_datetime,.keep_all=T) |> 
  arrange(project_id, busulfan_admin_time)

cohort |> count(project_id) #n=18

cohort |> select(project_id, birth_date,sex_name,busulfan_admin_time, collected_datetime,TestName,Value.y, height, weight) |> 
  write_csv("busulfan_2026_data.csv")
